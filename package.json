{
  "name": "kolkata-puja-guide",
  "private": true,
  "version": "0.1.0",
  "description": "PujaPath Kolkata Puja planner and public engineering office",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "icons": "node scripts/generate-icons.mjs",
    "check": "npm run build",
    "test": "npm run test:unit",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:office": "node scripts/verify-office.mjs",
    "test:e2e": "playwright test",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource/noto-sans-bengali": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "graphology": "^0.26.0",
    "graphology-shortest-path": "^2.1.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.56.0",
    "ngraph.path": "1.6.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "fast-xml-parser": "^5.11.2",
    "ngraph.graph": "20.0.0",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^4.1.11"
  }
}
